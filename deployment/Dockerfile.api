FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY api ./api
COPY shared ./shared
COPY scripts/build-api.mjs ./scripts/build-api.mjs
COPY public/contents/links/links.json ./public/contents/links/links.json
RUN npm run api:build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production API_DATA_DIR=/data
COPY --from=build /app/api/dist ./api/dist
RUN mkdir /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 8787
CMD ["node", "api/dist/server.mjs"]
