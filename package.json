{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && touch dist/.nojekyll",
    "preview": "vite preview",
    "api:serve": "npm run api:build && node api/dist/server.mjs",
    "api:config": "envsubst < api/wrangler.toml > api/wrangler.gen.toml",
    "api:deploy": "npm run api:config && wrangler deploy --config api/wrangler.gen.toml --var \"CACHE_VERSION:$(date +%s)\" \"STEAM_ID:$STEAM_ID\" \"DISCORD_ID:$DISCORD_ID\" \"LINKEDIN_URL:$LINKEDIN_URL\"",
    "lint": "eslint src scripts api/src api/tests shared tests/browser *.js --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"shared/*.{js,ts}\" \"api/{src,tests}/**/*.ts\" \"api/tsconfig*.json\" \"tests/browser/**/*.js\" \"*.js\" package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"shared/*.{js,ts}\" \"api/{src,tests}/**/*.ts\" \"api/tsconfig*.json\" \"tests/browser/**/*.js\" \"*.js\" package.json .prettierrc.json",
    "check": "npm run lint && npm run api:check && npm run format:check && npm run build && npm run test:site",
    "test:telegram": "tsx --test api/tests/telegram.test.ts",
    "test:spotify": "tsx --test api/tests/spotify.test.ts && node --test scripts/test-spotify.mjs",
    "api:build": "node scripts/build-api.mjs",
    "api:types": "wrangler types api/worker-configuration.d.ts --config api/wrangler.toml",
    "api:typecheck": "tsc -p api/tsconfig.json && tsc -p api/tsconfig.worker.json",
    "api:check": "npm run api:typecheck && npm run test:api && npm run api:build && wrangler deploy --dry-run --config api/wrangler.toml",
    "test:api": "tsx --test api/tests/*.test.ts && node --test scripts/test-spotify.mjs scripts/test-worker.mjs scripts/test-api-urls.mjs",
    "test:browser": "playwright test",
    "test:container": "docker build -f deployment/Dockerfile.api -t portfolio-api-validation . && tsx scripts/test-container.mjs",
    "test:site": "node --test scripts/test-site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@gitlab/fonts": "^1.3.1",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "parse5": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "wrangler": "^4"
  }
}
