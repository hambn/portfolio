{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @portfolio/web --",
    "build": "npm run build -w @portfolio/web --",
    "preview": "npm run preview -w @portfolio/web --",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run api:check && npm run test:web && npm run format:check && npm run build && npm run test:site",
    "test:site": "npm run test:site -w @portfolio/web --",
    "test:web": "npm run test:unit -w @portfolio/web --",
    "test:api": "npm run test -w @portfolio/api --",
    "test:browser": "npm run test:browser -w @portfolio/web --",
    "test:container": "npm run test:container -w @portfolio/api --",
    "test:telegram": "npm run test:telegram -w @portfolio/api --",
    "test:spotify": "npm run test:spotify -w @portfolio/api && npm run test:spotify -w @portfolio/web",
    "api:serve": "npm run serve -w @portfolio/api --",
    "api:build": "npm run build -w @portfolio/api --",
    "api:types": "npm run types -w @portfolio/api --",
    "api:typecheck": "npm run typecheck -w @portfolio/api --",
    "api:check": "npm run check -w @portfolio/api --",
    "api:config": "npm run config -w @portfolio/api --",
    "api:deploy": "npm run deploy -w @portfolio/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
